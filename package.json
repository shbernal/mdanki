{
  "name": "@shbernal/mdanki",
  "version": "3.0.0",
  "description": "Convert Markdown files to Anki cards.",
  "keywords": [
    "anki",
    "markdown",
    "cli",
    "flashcards",
    "deck-generation"
  ],
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mdanki": "./dist/bin.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "author": "shbernal <shbernal.01@gmail.com>",
  "homepage": "https://github.com/shbernal/mdanki",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/mdanki.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@shbernal/anki-apkg-export": "^5.1.0",
    "fast-glob": "^3.3.3",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "prismjs": "^1.30.0",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shbernal/flashcard-md-spec": "github:shbernal/flashcard-md-spec",
    "@types/node": "^26.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/sql.js": "^1.4.11",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.8.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
